# Copy to .env.local for local development (gitignored). All three or none:
# with none, the site runs in preview mode (sample data, open preview links).
# These end up in the browser bundle, so they must all be public values.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_…). Never the secret key: the build refuses one.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The Express API (d4ybe). Locally: npm run dev in d4ybe.
VITE_API_URL=http://localhost:8080
